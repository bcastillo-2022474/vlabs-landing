---
interface Props {
  color?: string;
  accent?: string;
  class?: string;
}
const { color = '#F4F2EC', accent = color, class: className } = Astro.props;
---

<svg viewBox="0 0 100 100" style="width:100%;height:100%;display:block" class={className} aria-hidden="true" focusable="false">
  <polygon points="0,0 30,0 50,58 70,0 100,0 66,100 34,100" fill={color}></polygon>
  <rect x="42" y="0" width="16" height="16" fill={accent}></rect>
</svg>
