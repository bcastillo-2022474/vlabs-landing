---
import Layout from '../layouts/Layout.astro';
import Mark from '../components/Mark.astro';

const title = 'Vector Labs | Software a la medida en Guatemala';
const description =
  'Software factory en Ciudad de Guatemala: diseñamos y construimos plataformas web, apps móviles y productos digitales a la medida. Criterio senior, entregas medibles.';

const waText = encodeURIComponent('Hola Vector Labs, me gustaría hablar sobre un proyecto.');
const phones = [
  { display: '+502 5432 8553', wa: '50254328553' },
  { display: '+502 4236 8689', wa: '50242368689' },
];

const services = [
  { n: '01', name: 'Plataformas web', text: 'Aplicaciones, portales y sistemas internos con arquitectura pensada para crecer.' },
  { n: '02', name: 'Apps móviles', text: 'iOS y Android desde una sola base de código, sin sacrificar experiencia.' },
  { n: '03', name: 'Producto y diseño', text: 'Descubrimiento, UX e interfaces. Definimos qué construir antes de escribir código.' },
  { n: '04', name: 'Equipos dedicados', text: 'Ingenieros que se integran a tu equipo con la cadencia y estándares de VLabs.' },
];

const steps = [
  { name: 'Descubrir', text: 'Entendemos el negocio, el usuario y la restricción real.' },
  { name: 'Diseñar', text: 'Prototipos validados y una arquitectura clara.' },
  { name: 'Construir', text: 'Sprints cortos, demos semanales, código revisado.' },
  { name: 'Escalar', text: 'Medimos, iteramos y mantenemos lo que entregamos.' },
];
---

<Layout title={title} description={description}>
  <a href="#main" class="skip">Saltar al contenido</a>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="brand" aria-label="Vector Labs — inicio">
        <span class="brand-mark"><Mark color="#F4F2EC" accent="#FF5A1F" /></span>
        <span class="brand-name">vlabs</span>
      </a>
      <nav aria-label="Principal">
        <a href="#servicios">Servicios</a>
        <a href="#proceso">Proceso</a>
        <a href="#contacto" class="nav-cta">Hablemos</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow">SOFTWARE FACTORY</p>
        <h1>Software a la medida, con dirección.</h1>
        <p class="lead">
          Diseñamos y construimos productos digitales para empresas que necesitan hacerlo bien la
          primera vez. Equipos pequeños, criterio senior, entregas medibles.
        </p>
        <div class="actions">
          <a href="#contacto" class="btn btn-primary">Iniciar un proyecto</a>
          <a href="#servicios" class="btn btn-ghost">Ver servicios</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="tag tl">V → (x, y)</span>
        <span class="tag br">VLABS / 001</span>
        <span class="hero-mark"><Mark color="#F4F2EC" accent="#FF5A1F" /></span>
      </div>
    </section>

    <section id="servicios" class="light" aria-labelledby="servicios-title">
      <div class="wrap section">
        <div class="section-head">
          <h2 id="servicios-title">Lo que construimos.</h2>
          <p class="eyebrow dim-light">SERVICIOS</p>
        </div>
        <ul class="services">
          {services.map((s) => (
            <li>
              <span class="num">{s.n}</span>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="proceso" class="wrap section" aria-labelledby="proceso-title">
      <div class="section-head">
        <h2 id="proceso-title">Un método, cuatro movimientos.</h2>
        <p class="eyebrow dim-dark">PROCESO</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class:list={{ last: i === steps.length - 1 }}>
            <span class="count">0{i + 1} / 04</span>
            <div>
              <h3>{s.name}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="contacto" class="contact" aria-labelledby="contacto-title">
      <div class="wrap contact-inner">
        <h2 id="contacto-title" class="big">HABLEMOS</h2>
        <p class="lead">
          Cuéntanos qué quieres construir. Respondemos en menos de 48 horas con una propuesta de
          siguiente paso.
        </p>
        <a href="mailto:hola@vectorlabs4u.tech" class="mail">hola@vectorlabs4u.tech <span aria-hidden="true">→</span></a>
        <ul class="phones" aria-label="WhatsApp">
          {phones.map((p) => (
            <li>
              <a
                href={`https://wa.me/${p.wa}?text=${waText}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Escribir por WhatsApp al ${p.display}`}
              >
                {p.display}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <a
    class="wa-fab"
    href={`https://wa.me/${phones[0].wa}?text=${waText}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escribir por WhatsApp a Vector Labs">WhatsApp</a
  >

  <footer>
    <div class="wrap foot">
      <div class="foot-brand">
        <span class="foot-mark"><Mark color="#8A867E" /></span>
        <span>Vector Labs · Ciudad de Guatemala</span>
      </div>
      <nav class="social" aria-label="Redes sociales">
        <a href="https://www.facebook.com/people/Vector-Labs/61595413003987/" target="_blank" rel="noopener noreferrer me">Facebook</a>
      </nav>
      <small>© 2026 VLABS</small>
    </div>
  </footer>
</Layout>

<style>
  .wrap { max-width: 1280px; margin: 0 auto; padding-inline: max(clamp(20px, 5vw, 32px), env(safe-area-inset-left), env(safe-area-inset-right)); }
  .section { padding-block: clamp(56px, 10vw, 128px); display: flex; flex-direction: column; gap: clamp(32px, 6vw, 56px); }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(17,17,16,.86); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { padding-block: 12px; min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: flex; align-items: center; gap: 12px; min-height: 44px; }
  .brand-mark { width: 26px; height: 26px; display: block; flex: none; }
  .brand-name { font-weight: 700; font-size: 22px; letter-spacing: -.05em; line-height: 1; }
  nav { display: flex; align-items: center; gap: clamp(4px, 2vw, 32px); font-size: 15px; color: var(--muted); }
  nav a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: clamp(8px, 1.5vw, 0px); }
  .nav-cta { color: var(--bg); background: var(--fg); padding-inline: 18px !important; font-weight: 500; }

  .eyebrow { margin: 0; font-family: var(--dot); font-weight: 900; font-size: 18px; letter-spacing: .12em; color: var(--accent); }
  .eyebrow.dim-light { color: var(--dim); }
  .eyebrow.dim-dark { color: var(--faint); }
  .lead { margin: 0; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--muted); max-width: 560px; text-wrap: pretty; }

  .hero { padding-block: clamp(48px, 12vw, 160px) clamp(48px, 10vw, 128px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: clamp(40px, 6vw, 64px); align-items: center; }
  .hero-copy { display: flex; flex-direction: column; gap: clamp(24px, 4vw, 36px); }
  h1 { margin: 0; font-size: clamp(48px, 6.6vw, 92px); font-weight: 600; letter-spacing: -.045em; line-height: .98; text-wrap: balance; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { padding: 16px 26px; font-size: 16px; min-height: 52px; display: inline-flex; align-items: center; justify-content: center; text-align: center; }
  .btn-primary { background: var(--accent); color: var(--bg); font-weight: 600; }
  .btn-ghost { border: 1px solid #3a3936; font-weight: 500; }
  .hero-art { justify-self: end; margin-inline: auto; width: 100%; max-width: 520px; aspect-ratio: 1; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; position: relative; }
  .tag { position: absolute; font-family: var(--mono); font-size: 12px; color: var(--faint); letter-spacing: .06em; }
  .tl { top: 16px; left: 18px; }
  .br { bottom: 16px; right: 18px; }
  .hero-mark { width: 52%; height: 52%; display: block; }

  .light { background: var(--fg); color: var(--bg); }
  .section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  h2 { margin: 0; font-size: clamp(36px, 4.4vw, 60px); font-weight: 600; letter-spacing: -.04em; line-height: 1; max-width: 680px; text-wrap: balance; }
  ul, ol { list-style: none; margin: 0; padding: 0; }
  h3 { margin: 0; }

  .services { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 1px solid var(--bg); }
  .services li { padding: clamp(24px, 5vw, 32px) 28px clamp(28px, 6vw, 40px) 0; display: flex; flex-direction: column; gap: 20px; border-bottom: 1px solid #dedad1; }
  .num { font-family: var(--dot); font-weight: 900; font-size: 32px; color: var(--accent); }
  .services h3 { font-size: 24px; font-weight: 600; letter-spacing: -.025em; }
  .services p { margin: 0; font-size: 16px; line-height: 1.55; color: #57544e; }

  .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .steps li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(20px, 5vw, 32px); display: flex; flex-direction: column; gap: clamp(24px, 6vw, 48px); min-height: 260px; }
  .count { font-family: var(--mono); font-size: 13px; color: var(--faint); letter-spacing: .06em; }
  .steps .last .count { color: var(--accent); }
  .steps h3 { font-size: 26px; font-weight: 600; letter-spacing: -.03em; margin-bottom: 12px; }
  .steps p { margin: 0; font-size: 16px; line-height: 1.55; color: var(--muted); }

  .contact { border-top: 1px solid var(--line); }
  .contact-inner { padding-block: clamp(80px, 12vw, 160px); display: flex; flex-direction: column; gap: 40px; align-items: flex-start; }
  .big { font-family: var(--dot); font-weight: 900; font-size: clamp(56px, 11vw, 160px); letter-spacing: .02em; line-height: .9; max-width: none; }
  .mail { white-space: nowrap; max-width: 100%; min-height: 48px; display: flex; align-items: center; gap: 16px; font-size: clamp(18px, 4.6vw, 40px); font-weight: 500; letter-spacing: -.03em; border-bottom: 2px solid var(--accent); padding-bottom: 8px; }
  .mail span { color: var(--accent); }

  .phones { display: flex; flex-wrap: wrap; gap: 12px 40px; font-family: var(--mono); font-size: clamp(18px, 2vw, 24px); letter-spacing: .02em; }
  .phones a { display: inline-flex; align-items: center; min-height: 48px; border-bottom: 1px solid #3a3936; }

  footer { border-top: 1px solid var(--line); }
  .foot { padding-block: 32px calc(32px + env(safe-area-inset-bottom)); display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; font-size: 14px; color: var(--faint); }
  .foot-brand { display: flex; align-items: center; gap: 12px; }
  .foot-mark { width: 18px; height: 18px; display: block; flex: none; }
  .social { display: flex; gap: 24px; font-size: 14px; color: var(--faint); }
  small { font-family: var(--mono); letter-spacing: .04em; font-size: 14px; }
  .wa-fab { display: none; }
  @media (max-width: 640px) {
    .steps li { min-height: 0; }
    .actions .btn { flex: 1 1 100%; }
    .hero-art { max-width: 340px; }
    .tag { font-size: 11px; }
    .foot { flex-direction: column; align-items: flex-start; }
    nav a:not(.nav-cta) { display: none; }
    .wa-fab { position: fixed; z-index: 15; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); display: inline-flex; align-items: center; min-height: 52px; padding: 0 22px; background: var(--accent); color: var(--bg); font-weight: 600; font-size: 16px; box-shadow: 0 6px 24px rgba(0,0,0,.45); }
    footer { padding-bottom: 72px; }
  }
  @media (hover: hover) {
    .brand:hover { color: inherit; }
    .nav-cta:hover { background: var(--accent); color: var(--bg); }
    .btn-primary:hover { background: var(--fg); color: var(--bg); }
    .btn-ghost:hover { border-color: var(--fg); color: var(--fg); }
    .phones a:hover { border-color: var(--accent); }
  }
</style>
